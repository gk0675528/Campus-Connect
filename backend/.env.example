# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application
ENVIRONMENT=development
DEBUG=False
APP_NAME=Pathzeo
APP_VERSION=1.1.0

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/campusconnect
DATABASE_ECHO=False
REDIS_URL=redis://localhost:6379/0

# Optional document database
MONGODB_ENABLED=True
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=campusconnect

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EXPOSE_RESET_OTP=False
DEMO_USER_PASSWORD=

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OAuth - LinkedIn
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# Payment - Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLIC_KEY=your-stripe-public-key

# Payment - Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_USER_PER_MINUTE=20
AI_RATE_LIMIT_GLOBAL_PER_MINUTE=300
RESUME_MAX_CHARS=20000
RESUME_MAX_FILE_SIZE_BYTES=2097152
RESUME_ALLOWED_EXTENSIONS=.txt,.pdf,.doc,.docx

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=campusconnect
AWS_REGION=us-east-1

# Sentry
SENTRY_DSN=

# CORS
# Comma-separated frontend origins, without a trailing slash.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Pricing defaults
PLATFORM_COMMISSION_MIN=0.10
PLATFORM_COMMISSION_MAX=0.20
PLATFORM_COMMISSION_DEFAULT=0.15

# Runtime
PORT=8000

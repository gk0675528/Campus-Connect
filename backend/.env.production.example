# Production environment template for CampusConnect
# Copy this to backend/.env before deployment, then replace the values

DEBUG=False
APP_NAME=CampusConnect
APP_VERSION=1.0.0

# PostgreSQL (preferred for production)
# Examples:
# Neon: postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/campusconnect?sslmode=require
# Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres
# Render/Railway/Azure: postgresql+asyncpg://campusconnect:YOUR_PASSWORD@HOST:5432/campusconnect
DATABASE_URL=postgresql+asyncpg://campusconnect:CHANGE_ME@your-postgres-host:5432/campusconnect

# Redis (managed or self-hosted)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@your-redis-host:6379/0

# Security
SECRET_KEY=replace-with-a-random-long-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain.com/auth/linkedin/callback

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=campusconnect
AWS_REGION=us-east-1

# Sentry
SENTRY_DSN=

# CORS
# Add your deployed frontend domain(s)
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com,https://your-api-domain.com

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

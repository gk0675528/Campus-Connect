{
  "info": {
    "name": "CampusConnect Auth and Password Reset",
    "description": "Registration, login, forgot-password OTP, OTP verification, and password reset requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "email", "value": "student@example.com" },
    { "key": "username", "value": "postman_student" },
    { "key": "password", "value": "password123" },
    { "key": "newPassword", "value": "newpassword123" },
    { "key": "otp", "value": "" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"Postman\",\n  \"last_name\": \"User\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const json = pm.response.json();",
            "pm.collectionVariables.set('accessToken', json.access_token);",
            "pm.test('Login succeeded', () => pm.expect(pm.response.code).to.eql(200));"
          ]
        }
      }]
    },
    {
      "name": "Request Password Reset OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/forgot-password"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "const json = pm.response.json();",
            "if (json.dev_otp) pm.collectionVariables.set('otp', json.dev_otp);",
            "pm.test('OTP request succeeded', () => pm.expect(pm.response.code).to.eql(200));"
          ]
        }
      }]
    },
    {
      "name": "Verify Password Reset OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/forgot-password/verify"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('OTP verified', () => pm.expect(pm.response.code).to.eql(200));"
          ]
        }
      }]
    },
    {
      "name": "Reset Password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\",\n  \"new_password\": \"{{newPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/forgot-password/reset"
      },
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Password reset succeeded', () => pm.expect(pm.response.code).to.eql(200));"
          ]
        }
      }]
    }
  ]
}
